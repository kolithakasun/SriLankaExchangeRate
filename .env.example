# Supabase (required for production history storage)
# Create a project at https://supabase.com and run migrations 001–004 in order.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for browser login (email/password). Never put the service role here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: refresh protection
# - Cooldown always applies (REFRESH_COOLDOWN_SECONDS)
# - Set REQUIRE_REFRESH_TOKEN=true to require x-refresh-token on every refresh
REFRESH_TOKEN=change-me-to-a-long-random-string
REQUIRE_REFRESH_TOKEN=false

# Optional: cooldown between public refresh attempts (seconds)
REFRESH_COOLDOWN_SECONDS=60

# Optional: how often the scheduled job should treat data as stale (minutes)
RATE_REFRESH_INTERVAL=30

# Optional: allow local JSON fallback when Supabase is not configured (dev only)
# ALLOW_LOCAL_STORE=true

# Optional: enables AI-written summaries on the Forecast panel.
# Without any of these, the Forecast panel still works fully (trend + best-day
# stats), just with a template-generated summary instead of an LLM-written one.
# Set whichever free key you have — both are genuinely free, no card required:

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (Llama models): https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the Groq model (defaults to llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# Optional: if both keys above are set, Gemini is tried first. Force a specific
# provider (gemini|groq) instead:
# AI_PROVIDER=gemini

# Cursor cloud narration (signed-in users only, max 2 generations per Colombo day).
# Create a key at https://cursor.com/dashboard/integrations — keep it server-side only.
CURSOR_API_KEY=
# Optional model id (default: auto). Example: composer-2.5
# CURSOR_MODEL=auto
# Optional cloud repo override (defaults to this project's GitHub URL on main):
# CURSOR_REPO_URL=https://github.com/kolithakasun/SriLankaExchangeRate.git
# CURSOR_REPO_REF=main
