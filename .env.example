# Supabase (required for production history storage)
# Create a project at https://supabase.com and run supabase/migrations/001_init.sql
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend may use the anon key for read-only access if you enable RLS policies.
# Prefer calling Netlify Functions instead of querying Supabase from the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: protect manual refresh endpoint
# Send header: x-refresh-token: <value>
REFRESH_TOKEN=change-me-to-a-long-random-string

# Optional: cooldown between public refresh attempts (seconds)
REFRESH_COOLDOWN_SECONDS=60

# Optional: how often the scheduled job should treat data as stale (minutes)
RATE_REFRESH_INTERVAL=30

# Optional: allow local JSON fallback when Supabase is not configured (dev only)
# ALLOW_LOCAL_STORE=true
